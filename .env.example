# Lume Store - Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# These are the ONLY environment variables that should be exposed to the browser.
# Never expose service_role key or private credentials to the frontend.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The service_role key should NEVER be used on the frontend.
# It should only be used in server-side environment variables or edge functions.
# SERVICE_ROLE_KEY=your_supabase_service_role_key_here  # <--- REMOVE THIS FOR PRODUCTION

# ============================================================
# APPLICATION SETTINGS
# ============================================================
NEXT_PUBLIC_APP_NAME=Lume Store
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development  # development | production | staging

# ============================================================
# FEATURE FLAGS
# ============================================================
NEXT_PUBLIC_ENABLE_FIADO=true
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false  # Set to true after cookie consent
NEXT_PUBLIC_ENABLE_WHATSAPP_REMINDER=true

# ============================================================
# PAYMENT AND LOGISTICS
# ============================================================
# When no gateway is configured, orders use manual confirmation
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENT=false  # Set to true when gateway is configured
NEXT_PUBLIC_DEFAULT_FIADO_DAYS=30  # Default due days for fiado sales

# ============================================================
# COOKIE AND TRACKING
# ============================================================
# Google Analytics and Meta Pixel configuration (when enabled)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ============================================================
# SECURITY
# ============================================================
# Rate limiting and security settings
NEXT_PUBLIC_RATE_LIMIT_WINDOW=900  # 15 minutes in seconds
NEXT_PUBLIC_RATE_LIMIT_MAX=100  # Max requests per window

# ============================================================
# DO NOT MODIFY BELOW THIS LINE
# ============================================================
# These variables are managed by the Supabase dashboard and CI/CD pipelines.
